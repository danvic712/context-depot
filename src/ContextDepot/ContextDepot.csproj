<Project Sdk="Microsoft.NET.Sdk.Web">

    <PropertyGroup>
        <SpaRoot>../ContextDepot.Web/</SpaRoot>
        <SpaProxyServerUrl>http://localhost:5173</SpaProxyServerUrl>
        <SpaProxyLaunchCommand>bun run --bun dev</SpaProxyLaunchCommand>
        <BuildFrontend Condition="'$(BuildFrontend)' == ''">false</BuildFrontend>
        <BunExecutable Condition="'$(BunExecutable)' == ''">bun</BunExecutable>
    </PropertyGroup>

    <ItemGroup Condition="'$(Configuration)' == 'Debug'">
        <PackageReference Include="Microsoft.AspNetCore.SpaProxy" />
        <ProjectReference Include="../ContextDepot.Web/context-depot.esproj">
            <ReferenceOutputAssembly>false</ReferenceOutputAssembly>
        </ProjectReference>
    </ItemGroup>

    <ItemGroup>
        <PackageReference Include="Microsoft.EntityFrameworkCore" />
        <PackageReference Include="Microsoft.EntityFrameworkCore.Design" PrivateAssets="all" />
        <PackageReference Include="ModelContextProtocol.AspNetCore" />
        <PackageReference Include="Serilog.AspNetCore" />
        <PackageReference Include="Serilog.Settings.Configuration" />
        <PackageReference Include="Serilog.Sinks.Console" />
        <PackageReference Include="Serilog.Sinks.File" />
    </ItemGroup>

    <ItemGroup>
      <ProjectReference Include="..\ContextDepot.Application\ContextDepot.Application.csproj" />
      <ProjectReference Include="..\ContextDepot.Infrastructure\ContextDepot.Infrastructure.csproj" />
    </ItemGroup>

    <!-- Opt in for local build/publish; CI and Docker build the frontend separately. -->
    <Target Name="BuildContextDepotFrontend"
            BeforeTargets="ResolveProjectStaticWebAssets;PrepareForBuild;ComputeFilesToPublish"
            DependsOnTargets="ValidateContextDepotVersion"
            Condition="'$(BuildFrontend)' == 'true' and '$(DesignTimeBuild)' != 'true'">
        <PropertyGroup>
            <_FrontendRoot>$([MSBuild]::NormalizeDirectory('$(MSBuildProjectDirectory)', 'wwwroot'))</_FrontendRoot>
        </PropertyGroup>
        <!-- Remove evaluated assets before Vite deletes obsolete hashed files. -->
        <ItemGroup>
            <Content Remove="@(Content)"
                     Condition="$([System.String]::Copy('%(Content.FullPath)').StartsWith('$(_FrontendRoot)'))" />
        </ItemGroup>
        <Exec Command="&quot;$(BunExecutable)&quot; install --frozen-lockfile"
              WorkingDirectory="$(MSBuildProjectDirectory)/$(SpaRoot)" />
        <Exec Command="&quot;$(BunExecutable)&quot; run --bun build"
              EnvironmentVariables="VITE_APP_VERSION=$(AppVersion);RELEASE_BUILD=$(ReleaseBuild)"
              WorkingDirectory="$(MSBuildProjectDirectory)/$(SpaRoot)" />
        <!-- Include the assets generated after project evaluation. -->
        <ItemGroup>
            <Content Include="wwwroot/**/*" CopyToPublishDirectory="PreserveNewest" />
        </ItemGroup>
    </Target>

    <!-- Include newly generated assets even when wwwroot did not exist at project evaluation. -->
    <Target Name="IncludeContextDepotFrontend" AfterTargets="ComputeFilesToPublish">
        <Error Condition="!Exists('$(MSBuildProjectDirectory)/wwwroot/index.html')"
               Text="Frontend assets are missing. Run bun run build in ContextDepot.Web or publish with -p:BuildFrontend=true." />
        <ItemGroup>
            <FrontendPublishFiles Include="wwwroot/**/*" />
            <ResolvedFileToPublish Include="@(FrontendPublishFiles->'%(FullPath)')"
                                   Exclude="@(ResolvedFileToPublish)">
                <RelativePath>wwwroot/%(FrontendPublishFiles.RecursiveDir)%(Filename)%(Extension)</RelativePath>
                <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
                <ExcludeFromSingleFile>true</ExcludeFromSingleFile>
            </ResolvedFileToPublish>
        </ItemGroup>
    </Target>
</Project>
