{
  "ConnectionStrings": {
    "ContextDepot": ""
  },
  "ContextDepot": {
    "MarkdownRoot": "data/context-depot/knowledge",
    "Owner": {
      "Id": "0199c000-0000-7000-8000-000000000001",
      "DisplayName": "Local Owner"
    },
    "Embedding": {
      "Provider": "ConfiguredGenerator",
      "Model": "embedding-model",
      "Dimensions": 1536,
      "Repair": {
        "PollIntervalSeconds": 30,
        "BatchSize": 32,
        "MaxBatchesPerCycle": 4
      }
    },
    "Retrieval": {
      "Semantic": {
        "ScopeTopK": 8,
        "CandidateTopKPerSource": 20,
        "OversampleFactor": 3,
        "RetrievalLexicalFallbackThreshold": 0.65,
        "DedupSimilarityThreshold": 0.98,
        "DedupTokenOverlapThreshold": 0.8
      },
      "Search": {
        "DefaultLimit": 10,
        "MaxLimit": 50
      }
    }
  },
  "Serilog": {
    "Using": [
      "Serilog.Sinks.Console",
      "Serilog.Sinks.File"
    ],
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.EntityFrameworkCore": "Warning"
      }
    },
    "Enrich": [
      "FromLogContext"
    ],
    "Properties": {
      "Application": "ContextDepot"
    },
    "WriteTo": [
      {
        "Name": "Console",
        "Args": {
          "outputTemplate": "[{Timestamp:yyyy-MM-dd HH:mm:ss.fff zzz} {Level:u3}] {SourceContext} {Message:lj}{NewLine}{Exception}"
        }
      },
      {
        "Name": "File",
        "Args": {
          "path": "logs/context-depot-.log",
          "rollingInterval": "Day",
          "retainedFileCountLimit": 14,
          "fileSizeLimitBytes": 10485760,
          "rollOnFileSizeLimit": true,
          "shared": true,
          "outputTemplate": "[{Timestamp:yyyy-MM-dd HH:mm:ss.fff zzz} {Level:u3}] {SourceContext} {Message:lj}{NewLine}{Exception}"
        }
      }
    ]
  },
  "AllowedHosts": "*"
}
